@page "/practice-sheet"
@inject IStringLocalizer<SharedResources> Loc

<PageTitle>@Loc["PageTitlePracticeSheet"]</PageTitle>

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">@Loc["NavHome"]</a></li>
            <li class="breadcrumb-item active">@Loc["NavPracticeSheet"]</li>
        </ol>
    </nav>

    <h1 class="mb-4">@Loc["NavPracticeSheet"]</h1>
    <p class="text-muted">@Loc["PracticePageDescription"]</p>

    <div class="card shadow-sm">
        <div class="card-body">
            <form action="/api/pdf/practice" method="get" target="_blank">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label for="minTable" class="form-label">@Loc["LabelMinTable"]</label>
                        <select id="minTable" name="minTable" class="form-select">
                            @for (int i = 1; i <= 12; i++)
                            {
                                <option value="@i" selected="@(i == 1)">@i</option>
                            }
                        </select>
                        <small class="text-muted">@Loc["HintLowestNumber"]</small>
                    </div>

                    <div class="col-md-4">
                        <label for="maxTable" class="form-label">@Loc["LabelMaxTable"]</label>
                        <select id="maxTable" name="maxTable" class="form-select">
                            @for (int i = 1; i <= 12; i++)
                            {
                                <option value="@i" selected="@(i == 12)">@i</option>
                            }
                        </select>
                        <small class="text-muted">@Loc["HintHighestNumber"]</small>
                    </div>

                    <div class="col-md-4">
                        <label for="sheetCount" class="form-label">@Loc["LabelSheetCount"]</label>
                        <select id="sheetCount" name="sheetCount" class="form-select">
                            @for (int i = 1; i <= 10; i++)
                            {
                                <option value="@i" selected="@(i == 1)">@i</option>
                            }
                        </select>
                        <small class="text-muted">@Loc["HintUniquePerSheet"]</small>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary btn-lg">
                        @Loc["BtnDownloadPracticeSheets"]
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">
            <h5 class="mb-0">@Loc["CardWhatYouGet"]</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h6>@Loc["PracticeContentTitle"]</h6>
                    <ul>
                        <li>@Loc["PracticeContent1"]</li>
                        <li>@Loc["PracticeContent2"]</li>
                        <li>@Loc["PracticeContent3"]</li>
                        <li>@Loc["PracticeContent4"]</li>
                        <li>@Loc["PracticeContent5"]</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <h6>@Loc["ExampleLayoutTitle"]</h6>
                    <div class="bg-light p-3 rounded">
                        <div class="row font-monospace small">
                            <div class="col-4">
                                <strong>@Loc["Group1"]</strong><br>
                                <span>&nbsp;1.&nbsp;&nbsp;3 ×&nbsp;&nbsp;5 = ____</span><br>
                                <span>&nbsp;2.&nbsp;&nbsp;7 ×&nbsp;&nbsp;2 = ____</span><br>
                                <span>&nbsp;3.&nbsp;10 ×&nbsp;&nbsp;8 = ____</span><br>
                                <span>...</span><br>
                                <span>10.&nbsp;&nbsp;4 ×&nbsp;&nbsp;6 = ____</span>
                            </div>
                            <div class="col-4">
                                <strong>@Loc["Group2"]</strong><br>
                                <span>11.&nbsp;&nbsp;6 ×&nbsp;&nbsp;3 = ____</span><br>
                                <span>12.&nbsp;&nbsp;9 ×&nbsp;&nbsp;7 = ____</span><br>
                                <span>13.&nbsp;&nbsp;2 × 11 = ____</span><br>
                                <span>...</span><br>
                                <span>20.&nbsp;12 ×&nbsp;&nbsp;5 = ____</span>
                            </div>
                            <div class="col-4">
                                <strong>@Loc["Group3"]</strong><br>
                                <span>21.&nbsp;&nbsp;5 ×&nbsp;&nbsp;4 = ____</span><br>
                                <span>22.&nbsp;&nbsp;8 ×&nbsp;&nbsp;6 = ____</span><br>
                                <span>23.&nbsp;11 ×&nbsp;&nbsp;9 = ____</span><br>
                                <span>...</span><br>
                                <span>30.&nbsp;&nbsp;1 × 12 = ____</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
