@page "/table-generator"
@page "/times-tables"
@inject IStringLocalizer<SharedResources> Loc

<PageTitle>@Loc["PageTitleTables"]</PageTitle>

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">@Loc["NavHome"]</a></li>
            <li class="breadcrumb-item active">@Loc["NavTimesTables"]</li>
        </ol>
    </nav>

    <h1 class="mb-4">@Loc["NavTimesTables"]</h1>
    <p class="text-muted">@Loc["TablePageDescription"]</p>

    <div class="card shadow-sm">
        <div class="card-body">
            <form action="/api/pdf/table" method="get" target="_blank">
                <input type="hidden" name="showAnswers" value="true" />
                <div class="row g-3">
                    <div class="col-md-4">
                        <label for="minTable" class="form-label">@Loc["LabelMinTable"]</label>
                        <select id="minTable" name="minTable" class="form-select">
                            @for (int i = 1; i <= 12; i++)
                            {
                                <option value="@i" selected="@(i == 1)">@i</option>
                            }
                        </select>
                        <small class="text-muted">@Loc["HintFirstTable"]</small>
                    </div>

                    <div class="col-md-4">
                        <label for="maxTable" class="form-label">@Loc["LabelMaxTable"]</label>
                        <select id="maxTable" name="maxTable" class="form-select">
                            @for (int i = 1; i <= 12; i++)
                            {
                                <option value="@i" selected="@(i == 12)">@i</option>
                            }
                        </select>
                        <small class="text-muted">@Loc["HintLastTable"]</small>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary btn-lg">
                        @Loc["BtnDownloadReference"]
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">
            <h5 class="mb-0">@Loc["CardWhatYouGet"]</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h6>@Loc["TableContentTitle"]</h6>
                    <ul>
                        <li>@Loc["TableContent1"]</li>
                        <li>@Loc["TableContent2"]</li>
                        <li>@Loc["TableContent3"]</li>
                        <li>@Loc["TableContent4"]</li>
                        <li>@Loc["TableContent5"]</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <h6>@Loc["ExampleFormatTitle"]</h6>
                    <div class="bg-light p-3 rounded font-monospace small">
                        <p class="mb-1"><strong>@Loc["ExampleTable1"]</strong></p>
                        <span>&nbsp;1 ×&nbsp;&nbsp;1 =&nbsp;&nbsp;&nbsp;1</span><br>
                        <span>&nbsp;1 ×&nbsp;&nbsp;2 =&nbsp;&nbsp;&nbsp;2</span><br>
                        <span>&nbsp;1 ×&nbsp;&nbsp;3 =&nbsp;&nbsp;&nbsp;3</span><br>
                        <span>...</span><br>
                        <span>&nbsp;1 × 12 =&nbsp;&nbsp;12</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
