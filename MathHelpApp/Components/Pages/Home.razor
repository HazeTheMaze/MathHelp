@page "/"

<PageTitle>Mattehjälpen - Hem</PageTitle>

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 class="display-4">Mattehjälpen</h1>
        <p class="lead text-muted">Skapa multiplikationstabeller och övningsblad för inlärning</p>
    </div>

    <div class="row justify-content-center g-4">
        <div class="col-md-5">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <span class="bi bi-grid-3x3-gap-fill display-4 text-primary"></span>
                    </div>
                    <h3 class="card-title">Multiplikationstabeller</h3>
                    <p class="card-text text-muted">
                        Skapa ett referensblad med alla multiplikationstabeller och svar för att studera och memorera.
                    </p>
                    <a href="/times-tables" class="btn btn-primary btn-lg">
                        <span class="bi bi-table me-2"></span>Hämta referensblad
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <span class="bi bi-pencil-square display-4 text-success"></span>
                    </div>
                    <h3 class="card-title">Övningsblad</h3>
                    <p class="card-text text-muted">
                        100 slumpade uppgifter i 10 grupper om 10. Skriv ut flera blad med facit för tidstester.
                    </p>
                    <a href="/practice-sheet" class="btn btn-success btn-lg">
                        <span class="bi bi-file-earmark-text me-2"></span>Skapa övningsblad
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
