@page "/"
@inject IStringLocalizer<SharedResources> Loc
@inject IBrowserPdfService PdfService
@inject IMultiplicationService MathService
@inject NavigationManager Navigation

<PageTitle>@Loc["PageTitleHome"]</PageTitle>

<div class="create-page">
    <div class="home-hero-card-wrapper">
        <div class="home-hero-card">
            <div class="home-card-inner">
                <p class="home-card-title text-muted">@Loc["CategoryMultiplication"]</p>

                <ul class="home-sheet-tabs" role="tablist">
                    <li role="presentation">
                        <button type="button"
                                role="tab"
                                aria-selected="@(!_showHelp && selectedType == PdfType.Reference)"
                                class="home-sheet-tab @(!_showHelp && selectedType == PdfType.Reference ? "active" : "")"
                                @onclick="@(() => { _showHelp = false; SelectType(PdfType.Reference); })">
                            @Loc["TabReferensblad"]
                        </button>
                    </li>
                    <li role="presentation">
                        <button type="button"
                                role="tab"
                                aria-selected="@(!_showHelp && selectedType == PdfType.Practice)"
                                class="home-sheet-tab @(!_showHelp && selectedType == PdfType.Practice ? "active" : "")"
                                @onclick="@(() => { _showHelp = false; SelectType(PdfType.Practice); })">
                            @Loc["TabOvningsblad"]
                        </button>
                    </li>
                    <li class="home-sheet-tabs-help" role="presentation">
                        <button type="button"
                                role="tab"
                                aria-selected="@_showHelp"
                                aria-label="@Loc["TabHelp"]"
                                class="home-sheet-tab home-sheet-tab-help @(_showHelp ? "active" : "")"
                                @onclick="@(() => _showHelp = !_showHelp)">
                            <span class="home-sheet-tab-icon" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                                    <circle cx="12" cy="12" r="10"/>
                                    <path d="M12 16v-4M12 8h.01"/>
                                </svg>
                            </span>
                        </button>
                    </li>
                </ul>

                @if (_showHelp)
                {
                    <div class="home-help-content text-muted">
                        <p class="mb-2">@Loc["HelpIntro"]</p>
                        <p class="mb-1">@Loc["TableRangeExplanation"]</p>
                        <p class="mb-0">@Loc["SheetCountExplanation"]</p>
                    </div>
                }
                else
                {
                    <div class="home-create-form @(selectedType == PdfType.Reference ? "is-reference" : "is-practice")">
                        <div class="row g-3 home-form-row">
                            <div class="col-md-4">
                                <label for="home-minTable" class="form-label">@Loc["LabelFromTable"]</label>
                                <select id="home-minTable" class="form-select" @bind="_minTable">
                                    @for (int i = 1; i <= 12; i++)
                                    {
                                        <option value="@i" disabled="@(i > _maxTable)">@i</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="home-maxTable" class="form-label">@Loc["LabelToTable"]</label>
                                <select id="home-maxTable" class="form-select" @bind="_maxTable">
                                    @for (int i = 1; i <= 12; i++)
                                    {
                                        <option value="@i" disabled="@(i < _minTable)">@i</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4 home-form-col-sheets">
                                <label for="home-sheetCount" class="form-label">@Loc["LabelSheetCount"]</label>
                                <select id="home-sheetCount" class="form-select" disabled="@(selectedType == PdfType.Reference)" @bind="_sheetCount">
                                    @for (int i = 1; i <= 10; i++)
                                    {
                                        <option value="@i">@i</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="mt-4 text-center">
                            <button type="button" class="btn btn-primary btn-lg" disabled="@_downloading" @onclick="OnDownloadPdf">
                                @(_downloading ? Loc["Loading"] : Loc["BtnDownloadPdf"])
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private enum PdfType { Reference, Practice }
    private PdfType selectedType = PdfType.Reference;
    private bool _showHelp;
    private int _minTable = 1;
    private int _maxTable = 12;
    private int _sheetCount = 1;
    private bool _downloading;

    private void SelectType(PdfType type)
    {
        selectedType = type;
    }

    private async Task OnDownloadPdf()
    {
        _downloading = true;
        try
        {
            if (selectedType == PdfType.Reference)
            {
                await PdfService.DownloadTablePdfAsync(_minTable, _maxTable, showAnswers: true);
            }
            else
            {
                var allSheets = new List<List<MultiplicationProblem>>();
                for (int i = 0; i < _sheetCount; i++)
                {
                    var problems = MathService.GenerateRandomProblems(_minTable, _maxTable, MathConstants.ProblemsPerSheet);
                    allSheets.Add(problems);
                }
                await PdfService.DownloadPracticePdfAsync(allSheets);
            }
        }
        finally
        {
            _downloading = false;
        }
    }
}
