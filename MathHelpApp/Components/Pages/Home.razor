@page "/"
@inject IStringLocalizer<SharedResources> Loc

<PageTitle>@Loc["PageTitleHome"]</PageTitle>

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 class="display-4">@Loc["AppName"]</h1>
        <p class="lead text-muted">@Loc["HomeDescription"]</p>
    </div>

    <div class="row justify-content-center g-4">
        <div class="col-md-5">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <span class="bi bi-grid-3x3-gap-fill display-4 text-primary"></span>
                    </div>
                    <h3 class="card-title">@Loc["CardTitleTimesTables"]</h3>
                    <p class="card-text text-muted">
                        @Loc["CardDescTimesTables"]
                    </p>
                    <a href="/times-tables" class="btn btn-primary btn-lg">
                        <span class="bi bi-table me-2"></span>@Loc["BtnGetReferenceSheet"]
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <span class="bi bi-pencil-square display-4 text-success"></span>
                    </div>
                    <h3 class="card-title">@Loc["CardTitlePracticeSheet"]</h3>
                    <p class="card-text text-muted">
                        @Loc["CardDescPracticeSheet"]
                    </p>
                    <a href="/practice-sheet" class="btn btn-success btn-lg">
                        <span class="bi bi-file-earmark-text me-2"></span>@Loc["BtnCreatePracticeSheet"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
