<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <InternalsVisibleTo Include="MathHelpApp.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.3.0</Version>
    <!-- Force x64 for QuestPDF native deps; arm64 is not supported -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" Version="10.0.3" GeneratePathProperty="true" />
    <PackageReference Include="QuestPDF" Version="2025.12.3" />
  </ItemGroup>

  <!-- Ensure Blazor framework script is in wwwroot so MapStaticAssets can serve it (WinExe/RID builds may not merge package assets). -->
  <Target Name="CopyBlazorFrameworkToWwwRoot" BeforeTargets="Build">
    <PropertyGroup>
      <_BlazorScriptSource>$(PkgMicrosoft_AspNetCore_App_Internal_Assets)\_framework\blazor.web.js</_BlazorScriptSource>
    </PropertyGroup>
    <MakeDir Directories="$(ProjectDir)wwwroot\_framework" Condition="!Exists('$(ProjectDir)wwwroot\_framework')" />
    <Copy SourceFiles="$(_BlazorScriptSource)" DestinationFolder="$(ProjectDir)wwwroot\_framework" SkipUnchangedFiles="true" Condition="Exists('$(_BlazorScriptSource)')" />
  </Target>

</Project>
